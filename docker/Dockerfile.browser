# ipadvid-browser: headless Chromium + puppeteer-core für den automatischen Viewer-Test.
# Build: docker build -f docker/Dockerfile.browser -t ipadvid-browser .
FROM node:22-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends chromium fonts-dejavu-core \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /test
RUN npm init -y >/dev/null && npm install --no-audit --no-fund puppeteer-core@23.11.1 >/dev/null
COPY test/headless.js /test/
ENV CHROME=/usr/bin/chromium
ENTRYPOINT ["node", "/test/headless.js"]
